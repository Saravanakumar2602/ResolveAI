# ResolveAI Agent Configuration
RESOLVE_AI_KEY=sk_resolve_demo_key
AI_PROVIDER=groq # Options: groq, gemini, openai, mock

# API Credentials (Keep in .env.local, do not commit)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# System Perception Settings
MAX_VISION_FPS=60
STRICT_HUMAN_APPROVAL=true
ENABLE_TOOL_VERIFICATION=true
